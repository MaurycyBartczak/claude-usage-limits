{
  "name": "usage-limits",
  "version": "0.3.0",
  "description": "Band above the prompt showing 5-hour session and weekly usage limits",
  "author": { "name": "MaurycyBartczak" },
  "types": "./types/index.d.ts",
  "userConfig": {
    "showFiveHour": {
      "type": "boolean",
      "title": "Pasek limitu sesji 5h",
      "description": "Pokazuj pasek zużycia limitu 5-godzinnego",
      "default": true
    },
    "showWeekly": {
      "type": "boolean",
      "title": "Pasek limitu tygodniowego",
      "description": "Pokazuj pasek zużycia limitu tygodniowego",
      "default": true
    },
    "showBurn": {
      "type": "boolean",
      "title": "Wykres spalania tokenów",
      "description": "Pokazuj wykres tokenów zużytych w każdej turze",
      "default": true
    },
    "showForecast": {
      "type": "boolean",
      "title": "Prognoza limitu 5h",
      "description": "Pokazuj, kiedy przy obecnym tempie limit 5h dojdzie do 100%",
      "default": true
    },
    "showCost": {
      "type": "boolean",
      "title": "Koszt sesji w $",
      "description": "Pokazuj koszt sesji (równowartość cen API)",
      "default": true
    },
    "animations": {
      "type": "boolean",
      "title": "Animacje",
      "description": "Płynne wypełnianie, połysk, pulsowanie i spinner",
      "default": true
    },
    "thresholdToasts": {
      "type": "boolean",
      "title": "Powiadomienia przy progach",
      "description": "Powiadomienie, gdy limit przekroczy 50%, 75% lub 90%",
      "default": true
    },
    "sound90": {
      "type": "boolean",
      "title": "Dźwięk przy 90%",
      "description": "Sygnał dźwiękowy, gdy limit przekroczy 90%",
      "default": true
    },
    "resetToast": {
      "type": "boolean",
      "title": "Powiadomienie o resecie",
      "description": "Powiadomienie, gdy limit się zresetuje",
      "default": true
    }
  }
}
